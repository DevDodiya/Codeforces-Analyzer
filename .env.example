# Copy this file to .env and fill in your own Codeforces API credentials.
# Generate them at: https://codeforces.com/settings/api
# The .env file is git-ignored and must NEVER be committed.

CODEFORCES_API_KEY=your_codeforces_api_key_here
CODEFORCES_API_SECRET=your_codeforces_api_secret_here
CODEFORCES_RANDOM_STRING=123456
